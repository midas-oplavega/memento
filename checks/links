#!/usr/bin/env python3
"""links — checks that each relative link in the repository's tracked Markdown,
inline or by reference, image or not, resolves: to a tracked file or folder,
with its case exact, and, for a link with an anchor, to a heading in it. A
link starting with "/" is read from the repository's root, as GitHub reads
it. Links to outside sites are left to a scheduled check, and files named
*-template.md are skipped, since their links resolve once they are copied.
Prints one line for each broken link, and exits 1 when there is any.

The automating-checks skill says where it runs."""
import posixpath
import re
from urllib.parse import unquote
import subprocess
import sys
from pathlib import Path

LINK = re.compile(r"\]\(\s*(<[^>]*>|(?:[^()\s\\]|\\.|\([^()\s]*\))+)"
                  r"(?:\s+(?:\"[^\"]*\"|'[^']*'|\([^)]*\)))?\s*\)")
DEFINITION = re.compile(r"^ {0,3}\[(?!\^)[^\]]+\]:\s*(<[^>]*>|\S+)")
SETEXT = re.compile(r"^ {0,3}(=+|-+)\s*$")
FENCE = re.compile(r"^\s*(```|~~~)")
CODE = re.compile(r"`[^`]*`")
ESCAPE = re.compile(r"\\([!-/:-@\[-`{-~])")
OUTSIDE = re.compile(r"^[a-z][a-z0-9+.-]*:|^//", re.IGNORECASE)


def lines_outside_fences(path):
    """Each line of a Markdown file with its number, fenced blocks left out."""
    fenced = False
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if FENCE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            yield number, line


def headings(path):
    """The text of each heading in a Markdown file: "#" headings, with any
    closing hashes, and text underlined with "=" or "-"."""
    previous = ""
    for _, line in lines_outside_fences(path):
        if line.startswith("#"):
            yield re.sub(r"\s+#+\s*$", "", line.lstrip("#")).strip()
        elif SETEXT.match(line) and previous.strip():
            yield previous.strip()
        previous = line


def anchors(path):
    """The anchors GitHub gives a Markdown file's headings."""
    seen, found = {}, set()
    for heading in headings(path):
        text = heading.lower()
        slug = re.sub(r"[^\w\- ]", "", text).replace(" ", "-")
        count = seen.get(slug, 0)
        seen[slug] = count + 1
        found.add(slug if count == 0 else f"{slug}-{count}")
    return found


def main():
    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True, check=True).stdout.strip())
    names = subprocess.run(["git", "ls-files", "-z", "--", "*.md"], cwd=root,
                           capture_output=True, text=True, check=True).stdout.split("\0")
    tracked = set(subprocess.run(["git", "ls-files", "-z"], cwd=root, capture_output=True,
                                 text=True, check=True).stdout.split("\0"))
    folders = {"."}
    for path in tracked:
        folder = posixpath.dirname(path)
        while folder:
            folders.add(folder)
            folder = posixpath.dirname(folder)
    broken = 0
    for name in filter(None, names):
        if name.endswith("-template.md"):
            continue
        source = root / name
        for number, line in lines_outside_fences(source):
            line = CODE.sub("", line)
            for target in LINK.findall(line) + DEFINITION.findall(line):
                target = target[1:-1] if target.startswith("<") else target
                if OUTSIDE.match(target):
                    continue
                file_part, _, anchor = target.partition("#")
                file_part = unquote(ESCAPE.sub(r"\1", file_part))
                if not file_part:
                    path = name
                elif file_part.startswith("/"):
                    path = posixpath.normpath(file_part.lstrip("/"))
                else:
                    path = posixpath.normpath(posixpath.join(posixpath.dirname(name), file_part))
                if path not in tracked and path.rstrip("/") not in folders:
                    print(f"links: {name}:{number}: {target}: no such tracked file")
                    broken += 1
                elif anchor and path.endswith(".md") and anchor not in anchors(root / path):
                    print(f"links: {name}:{number}: {target}: no such heading")
                    broken += 1
    return 1 if broken else 0


sys.exit(main())
