#!/bin/sh
#
# secrets — refuses a push that carries a secret. gitleaks scans what each
# ref on its input carries, its commits' changes and messages, and an
# annotated tag's message, and names each finding by rule, file, line,
# commit and fingerprint, never with its value. It takes the hook's line for
# each ref on its input, and no arguments but --tools, and runs at the
# repository's root, where gitleaks reads .gitleaksignore.
#
# In a push, a ref carries the commits no remote's branch holds, as known at
# the last fetch: a commit a remote holds has already left the machine.
# Outside a push, in CI or at qualification, with CHECKS_OUTSIDE_PUSH=1, it
# carries exactly the commits from the line's old commit to its new one.
#
# It fails on a finding; when no line on its input names a ref; when the
# commits can't all be read; when a .gitleaksignore or .gitleaks.toml isn't
# the commit's own; and when gitleaks or git is missing or older than the
# versions below. A line for a deletion is skipped. With --tools, it checks
# the tools alone, as setup-project.sh does. The automating-checks skill
# says how to install gitleaks.

gitleaks_needed=8.30.1
git_needed=2.36

# Succeeds when version $1 is $2 or later, compared part by part.
at_least() {
  awk -v have="$1" -v need="$2" 'BEGIN {
    n = split(have, h, "."); m = split(need, w, ".")
    for (i = 1; i <= (n > m ? n : m); i++) {
      if (h[i] + 0 > w[i] + 0) exit 0
      if (h[i] + 0 < w[i] + 0) exit 1
    }
    exit 0
  }'
}

missing=0
have="$(gitleaks version 2>/dev/null | sed -n '1{s/^v//;p;}')"
if [ -z "$have" ] || ! at_least "$have" "$gitleaks_needed"; then
  echo "secrets: gitleaks $gitleaks_needed or later is needed, and" \
    "${have:-none} is installed; the automating-checks skill says how to" \
    "install it." >&2
  missing=1
fi
have="$(git version | sed -n 's/^git version \([0-9.]*\).*/\1/p')"
if ! at_least "$have" "$git_needed"; then
  echo "secrets: git $git_needed or later is needed, for --remerge-diff," \
    "and $have is installed; the automating-checks skill says what the" \
    "scanner needs." >&2
  missing=1
fi
[ "$missing" -eq 0 ] || exit 1
[ "${1:-}" = --tools ] && exit 0

# gitleaks's settings come from the commit alone: a file no commit or review
# shows, or one set in the environment, could silence a finding.
own="$(git ls-files --others -- .gitleaksignore .gitleaks.toml)"
if [ -n "$own" ] || ! git diff --quiet HEAD -- .gitleaksignore .gitleaks.toml; then
  echo "secrets: refused, .gitleaksignore or .gitleaks.toml isn't the" \
    "commit's own; commit it or remove it." >&2
  exit 1
fi
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
# A local replacement of a commit would show gitleaks another one than the
# push carries.
GIT_NO_REPLACE_OBJECTS=1
export GIT_NO_REPLACE_OBJECTS

report="$(mktemp)" || exit 1
log="$(mktemp)" || exit 1
trap 'rm -f "$report" "$log"' EXIT
trap 'exit 1' INT TERM HUP
printf '%s\n%s' '{{range .}}secrets: {{.RuleID}} in {{.File}}:{{.StartLine}}, commit {{.Commit}}, fingerprint {{.Fingerprint}}' '{{end}}' > "$report"

# Succeeds when gitleaks finds nothing in its input.
clean() {
  gitleaks stdin --redact --no-banner --log-level error \
    --ignore-gitleaks-allow > /dev/null 2>&1
}

refs=0
found=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  refs=$((refs + 1))
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if [ "${CHECKS_OUTSIDE_PUSH:-}" = 1 ]; then
    case "$remote_sha" in
      *[!0]*) range="$remote_sha..$local_sha" ;;
      *) range="$local_sha" ;;
    esac
  else
    case "$remote_sha" in
      *[!0]*) range="$local_sha --not $remote_sha --remotes" ;;
      *) range="$local_sha --not --remotes" ;;
    esac
  fi
  # gitleaks passes when git itself fails, so git reads the range first.
  # shellcheck disable=SC2086
  if ! git log --remerge-diff --max-count=0 $range -- > /dev/null 2>&1; then
    echo "secrets: the commits $local_ref carries can't be read; fetch" \
      "first." >&2
    exit 1
  fi
  # Git's own settings, such as colour, an attribute marking files binary, a
  # text conversion or hiding a root commit's diff, would hide changes from
  # gitleaks; these options undo them. gitleaks passes when git fails
  # partway, so an error in its log, its level field alone, fails the scan.
  gitleaks git --redact --no-banner --ignore-gitleaks-allow --log-level warn \
    --log-opts="--remerge-diff --root --no-color --text --no-textconv --no-ext-diff $range" \
    --report-format template --report-template "$report" \
    --report-path - . >&2 2> "$log" || found=1
  cat "$log" >&2
  esc="$(printf '\033')"
  if sed "s/$esc\[[0-9;]*m//g" "$log" | grep -Eq '^[^ ]+ (ERR|FTL) '; then
    echo "secrets: gitleaks couldn't read every commit $local_ref carries," \
      "so it wasn't scanned; fetch, or repair the repository, first." >&2
    exit 1
  fi
  # shellcheck disable=SC2086
  if ! git log --encoding=UTF-8 --format=%B $range | clean; then
    for commit in $(git rev-list $range); do
      git log -1 --encoding=UTF-8 --format=%B "$commit" | clean ||
        echo "secrets: a secret in the message of commit $commit" >&2
    done
    found=1
  fi
  if [ "$(git cat-file -t "$local_sha")" = tag ] &&
    ! git cat-file tag "$local_sha" | sed '1,/^$/d' | clean; then
    echo "secrets: a secret in the message of tag ${local_ref#refs/tags/}" >&2
    found=1
  fi
done

if [ "$refs" -eq 0 ]; then
  echo "secrets: nothing to scan" >&2
  exit 1
fi
if [ "$found" -ne 0 ]; then
  echo "secrets: refused. The securing-a-product skill says what follows" \
    "for a secret found before a push; never print its value." >&2
  exit 1
fi
exit 0
